{
  "name": "isp-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "deploy": "npm ci --ignore-scripts --no-update-notifier --omit=dev && npm run build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss}\" \"e2e/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,scss}\" \"e2e/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest --mode test",
    "test:cov": "vitest run --mode test --coverage",
    "pree2e": "playwright install chromium",
    "e2e": "playwright test --project=chromium",
    "e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@carbon/icons-react": "^11.64.0",
    "@carbon/react": "^1.88.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.18.2",
    "sass-embedded": "^1.86.0",
    "vite": "^8.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.0.0",
    "@playwright/test": "^1.51.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.2.3",
    "jsdom": "^29.0.0",
    "prettier": "^3.5.3",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.58.2",
    "vitest": "^4.0.0"
  }
}
