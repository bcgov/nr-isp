# The image build copies only pom.xml, src/ and checks/; keep everything else out of the context.

# IDE and editor files
.idea/
*.iml
*.iws
.project
.classpath
.settings/

# Build output and crash logs
target/
*.class
*.jar
*.war
*.log
hs_err_pid*
replay_pid*

# Maven release and wrapper leftovers
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/
mvnw.cmd

# Local configuration
config/
.env
.env.*
Dockerfile

# Local-only Oracle credentials and trust material must never enter an image build context.
src/main/resources/application-local.yml
src/main/resources/cert/
