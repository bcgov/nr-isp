# ===========================================
# ISP Backend Environment Variables
# ===========================================
# Reference for the settings the backend reads. For local runs prefer
# src/main/resources/application-local.yml (gitignored) or shell env vars.

# Server
SERVER_PORT=8080

# Spring: add `oracle` to connect to the shared Oracle database
SPRING_PROFILES_ACTIVE=oracle

# Oracle (TCPS)
DATABASE_HOST=
DATABASE_PORT=1543
DATABASE_SERVICE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
KEYSTORE_SECRET=
TRUSTSTORE_PATH=/cert/jssecacerts

# BC Gov SSO / FAM interactive users (required; the API refuses to start without them)
ISP_OIDC_ISSUER_URI=
ISP_OIDC_CLIENT_ID=
# Optional override; defaults to <issuer>/protocol/openid-connect/certs
# ISP_OIDC_JWK_SET_URI=

# App config
ALLOWED_ORIGINS=http://localhost:3000
APP_LOG_LEVEL=INFO
